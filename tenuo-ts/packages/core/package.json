{
  "name": "@tenuo/core",
  "version": "0.2.5-beta.0",
  "description": "Tenuo TypeScript SDK — authorization decisions run in the Rust core (WASM).",
  "license": "Apache-2.0",
  "author": "Tenuo Contributors",
  "homepage": "https://github.com/tenuo-ai/tenuo/tree/main/tenuo-ts/packages/core",
  "bugs": {
    "url": "https://github.com/tenuo-ai/tenuo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tenuo-ai/tenuo.git",
    "directory": "tenuo-ts/packages/core"
  },
  "keywords": [
    "tenuo",
    "authorization",
    "agents",
    "mcp",
    "wasm",
    "capabilities"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "./dist/generated/**"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-build-assets.mjs",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "publish:npm": "npm publish --access public --provenance --tag beta",
    "build:wasm": "pnpm --dir ../.. build:wasm"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "@types/node": "^22.13.10",
    "fast-check": "4.9.0",
    "typescript": "~5.8.2",
    "vitest": "^3.0.9",
    "zod": "3.25.76"
  }
}
