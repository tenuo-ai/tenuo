{
  "realm": "tenuo-smoke",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 180,
  "clientScopes": [
    {"name": "basic", "protocol": "openid-connect", "protocolMappers": [
      {"name": "subject", "protocol": "openid-connect", "protocolMapper": "oidc-sub-mapper",
       "config": {"access.token.claim": "true"}}
    ]},
    {"name": "refunds:write", "protocol": "openid-connect", "attributes": {"include.in.token.scope": "true"}},
    {"name": "mail:send", "protocol": "openid-connect", "attributes": {"include.in.token.scope": "true"}}
  ],
  "users": [
    {"id": "11111111-1111-4111-8111-111111111111", "username": "alice", "enabled": true,
     "firstName": "Alice", "lastName": "Example", "email": "alice@example.test", "emailVerified": true,
     "attributes": {"tenant_id": ["acme"]},
     "credentials": [{"type": "password", "value": "local-smoke-password", "temporary": false}]},
    {"id": "22222222-2222-4222-8222-222222222222", "username": "bob", "enabled": true,
     "firstName": "Bob", "lastName": "Example", "email": "bob@example.test", "emailVerified": true,
     "attributes": {"tenant_id": ["other"]},
     "credentials": [{"type": "password", "value": "local-smoke-password", "temporary": false}]}
  ],
  "clients": [
    {"clientId": "support", "protocol": "openid-connect", "publicClient": true,
     "standardFlowEnabled": true, "directAccessGrantsEnabled": false,
     "redirectUris": ["http://127.0.0.1:18765/callback"],
     "attributes": {"pkce.code.challenge.method": "S256"},
     "defaultClientScopes": ["basic", "refunds:write"],
     "protocolMappers": [
       {"name": "authority-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
        "config": {"included.custom.audience": "tenuo-authority", "access.token.claim": "true", "id.token.claim": "false"}},
       {"name": "tenant", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper",
        "config": {"user.attribute": "tenant_id", "claim.name": "tenant_id", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false"}}
     ]}
  ]
}
