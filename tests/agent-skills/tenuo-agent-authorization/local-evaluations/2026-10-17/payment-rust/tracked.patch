+//! Fake payment service with mandatory holder-bound authorization.
+//!
+//! The original raw client route is inaccessible, including at its defining module:
+//! ```compile_fail
+//! use payment_service_eval::PaymentClient;
+//! let mut client = PaymentClient::default();
+//! client.transfer("merchant", 200);
+//! ```
+//! The original unguarded function signature is also unavailable:
+//! ```compile_fail
+//! use payment_service_eval::{execute_transfer, PaymentService};
+//! let issuer = tenuo::SigningKey::generate();
+//! let mut service = PaymentService::new(issuer.public_key());
+//! execute_transfer(&mut service, "merchant", 200);
+//! ```
+
+use std::{collections::HashMap, time::Duration};
+use tenuo::sdk::prelude::*;
+use tenuo::{
+    ConstraintSet, ConstraintValue, ErrorCode, Exact, PublicKey, Range, Signature, SigningKey,
+    Warrant,
+};
+
+pub const CAPABILITY: &str = "payment.transfer";
+/// Integer minor currency units; deliberately well inside f64's exact integer domain.
+pub const MAX_AMOUNT: u64 = 1_000_000;
+pub const MAX_TTL: Duration = Duration::from_secs(300);
+
+#[derive(Clone, Debug)]
+pub struct Transfer {
+    pub recipient: String,
+    pub amount: u64,
+}
+impl Transfer {
+    fn arguments(&self) -> Result<HashMap<String, ConstraintValue>, TransferError> {
+        if self.recipient.is_empty()
+            || self.recipient.len() > 256
+            || self.amount == 0
+            || self.amount > MAX_AMOUNT
+        {
+            return Err(TransferError::InvalidArguments);
+        }
+        Ok(HashMap::from([
+            (
+                "recipient".into(),
+                ConstraintValue::String(self.recipient.clone()),
+            ),
+            (
+                "amount".into(),
+                ConstraintValue::Integer(
+                    i64::try_from(self.amount).map_err(|_| TransferError::InvalidArguments)?,
+                ),
+            ),
+        ]))
+    }
+}
+
+/// Public transport data only: complete root-first chain and holder signature.
+#[derive(Clone)]
+pub struct Presentation {
+    pub chain: Vec<Vec<u8>>,
+    pub proof: Signature,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum TransferError {
+    MissingAuthority,
+    MalformedAuthority,
+    InvalidArguments,
+    Denied(Option<ErrorCode>),
+}
+
+/// Issuer-side entrypoint. Run under the authority owner's control, outside the caller.
+pub fn issue_transfer(
+    issuer: &SigningKey,
+    holder: PublicKey,
+    recipient: &str,
+    max_amount: u64,
+) -> Result<Warrant, TransferError> {
+    Transfer {
+        recipient: recipient.into(),
+        amount: max_amount,
+    }
+    .arguments()?;
+    Warrant::builder()
+        .capability(CAPABILITY, transfer_constraints(recipient, max_amount)?)
+        .holder(holder)
+        .ttl(MAX_TTL)
+        .max_depth(1)
+        .build(issuer)
+        .map_err(|e| TransferError::Denied(Some(e.code())))
+}
+
+fn transfer_constraints(recipient: &str, amount: u64) -> Result<ConstraintSet, TransferError> {
+    let mut constraints = ConstraintSet::new();
+    constraints.insert("recipient", Exact::new(recipient));
+    constraints.insert(
+        "amount",
+        Range::between(1.0, amount as f64).map_err(|_| TransferError::InvalidArguments)?,
+    );
+    Ok(constraints)
+}
+
+/// Holder-side entrypoint. The private key stays here; it is never sent to the service.
+pub fn present(
+    chain: &[Warrant],
+    holder: &SigningKey,
+    transfer: &Transfer,
+) -> Result<Presentation, TransferError> {
+    let leaf = chain.last().ok_or(TransferError::MalformedAuthority)?;
+    if leaf.authorized_holder() != &holder.public_key() {
+        return Err(TransferError::MalformedAuthority);
+    }
+    let args = transfer.arguments()?;
+    let proof = leaf
+        .sign(holder, CAPABILITY, &args)
+        .map_err(|_| TransferError::MalformedAuthority)?;
+    let chain = chain
+        .iter()
+        .map(tenuo::wire::encode)
+        .collect::<Result<_, _>>()
+        .map_err(|_| TransferError::MalformedAuthority)?;
+    Ok(Presentation { chain, proof })
+}
