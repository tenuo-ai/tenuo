+
+pub struct PaymentService {
+    verifier: Guard,
+    client: PaymentClient,
+}
+impl PaymentService {
+    /// Trusted operator construction: only this issuer is trusted, never request-provided roots.
+    pub fn new(issuer: PublicKey) -> Self {
+        let verifier = Tenuo::enforcement()
+            .trusted_root(issuer)
+            .revocation(RevocationMode::TtlOnly {
+                max_lifetime: MAX_TTL,
+            })
+            .denial_reporting(DenialReporting::Debug)
+            .build()
+            .expect("fixed verifier configuration");
+        Self {
+            verifier,
+            client: PaymentClient::default(),
+        }
+    }
+    pub fn calls(&self) -> &[(String, u64)] {
+        &self.client.calls
+    }
+    pub fn transfer(
+        &mut self,
+        transfer: Transfer,
+        authority: Option<&Presentation>,
+    ) -> Result<(), TransferError> {
+        let args = transfer.arguments()?;
+        let authority = authority.ok_or(TransferError::MissingAuthority)?;
+        if authority.chain.is_empty()
+            || authority.chain.len() > 2
+            || authority.chain.iter().any(|w| w.len() > 16384)
+        {
+            return Err(TransferError::MalformedAuthority);
+        }
+        let chain = authority
+            .chain
+            .iter()
+            .map(|bytes| tenuo::wire::decode(bytes))
+            .collect::<Result<Vec<_>, _>>()
+            .map_err(|e| TransferError::Denied(Some(e.code())))?;
+        let received = ReceivedAuthorization::new(&chain, &authority.proof, &[])
+            .map_err(|_| TransferError::MalformedAuthority)?;
+        let projection = VerifiedProjection::identical(args);
+        let call = Call::from_transport(CAPABILITY, &projection);
+        self.verifier
+            .check_received(&received, &call)
+            .map_err(|e| TransferError::Denied(e.protocol_code()))?;
+        // No caller callback or await between verification and the owned fake effect.
+        self.client.transfer(&transfer.recipient, transfer.amount);
+        Ok(())
+    }
 }
+
+pub fn execute_transfer(
+    service: &mut PaymentService,
+    transfer: Transfer,
+    authority: Option<&Presentation>,
+) -> Result<(), TransferError> {
+    service.transfer(transfer, authority)
+}
