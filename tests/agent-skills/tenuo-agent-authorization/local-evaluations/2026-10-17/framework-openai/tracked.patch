+@dataclass(frozen=True)
+class RefundSession:
+    service: RefundService
+    chain: tuple[str, ...]
+    holder: SigningKey
+
+    def present(self, args):
+        leaf = Warrant.from_base64(self.chain[-1])
+        return Presentation(self.chain, leaf.sign(self.holder, "refund_order", args, int(time.time())))
+
