{
  "description": "Normative Shlex decisions shared by the Rust core, Python, and TypeScript. Words follow POSIX shell rules: words break only at spaces, tabs, and operators, and # is an ordinary word character so operators after # are still rejected. Quoted or escaped operator characters are literal arguments. $ and backticks are rejected in the raw command, including inside quotes. Each allow entry matches the command word literally, and any command word containing .. is rejected.",
  "cases": [
    {"name": "simple command", "allow": ["ls"], "command": "ls -la /tmp", "matches": true},
    {"name": "quoted semicolon", "allow": ["ls"], "command": "ls \"foo; bar\"", "matches": true},
    {"name": "single quoted operators", "allow": ["ls"], "command": "ls 'foo && bar'", "matches": true},
    {"name": "quoted pipe", "allow": ["grep"], "command": "grep \"a|b\" file", "matches": true},
    {"name": "quoted ampersand", "allow": ["echo"], "command": "echo \"AT&T\"", "matches": true},
    {"name": "quoted angle brackets", "allow": ["echo"], "command": "echo \"<html>\"", "matches": true},
    {"name": "expansion inside double quotes", "allow": ["echo"], "command": "echo \"$VAR\"", "matches": false},
    {"name": "expansion inside single quotes", "allow": ["echo"], "command": "echo '$HOME'", "matches": false},
    {"name": "escaped dollar in double quotes", "allow": ["echo"], "command": "echo \"\\$HOME\"", "matches": false},
    {"name": "backtick substitution", "allow": ["ls"], "command": "ls `pwd`", "matches": false},
    {"name": "tab is whitespace", "allow": ["ls"], "command": "ls\t-la", "matches": true},
    {"name": "newline is a control character", "allow": ["ls", "rm"], "command": "ls\nrm", "matches": false},
    {"name": "carriage return", "allow": ["ls"], "command": "ls\rrm", "matches": false},
    {"name": "null byte", "allow": ["ls"], "command": "ls\u0000rm", "matches": false},
    {"name": "unquoted semicolon", "allow": ["ls", "rm"], "command": "ls;rm", "matches": false},
    {"name": "unquoted and", "allow": ["ls", "rm"], "command": "ls&&rm", "matches": false},
    {"name": "operator run", "allow": ["cat"], "command": "cat <> /etc/passwd", "matches": false},
    {"name": "heredoc", "allow": ["cat"], "command": "cat <<EOF", "matches": false},
    {"name": "dotdot in binary rejected", "allow": ["/usr/bin/ls", "ls"], "command": "/usr/bin/../bin/ls -la", "matches": false},
    {"name": "traversal to a different binary", "allow": ["ls"], "command": "/bin/../bin/rm -rf /", "matches": false},
    {"name": "operator after hash at start of word is rejected", "allow": ["ls"], "command": "ls #; rm", "matches": false},
    {"name": "hash without operators is allowed", "allow": ["ls"], "command": "ls -la # note", "matches": true},
    {"name": "hash inside a word does not start a comment", "allow": ["ls"], "command": "ls foo#; rm -rf /", "matches": false},
    {"name": "comma stays in the command name", "allow": ["ls"], "command": "./ls,evil -la", "matches": false},
    {"name": "quoted operator character", "allow": ["echo"], "command": "echo \";\"", "matches": true},
    {"name": "escaped operator is an argument", "allow": ["find"], "command": "find . -exec rm {} \\;", "matches": true},
    {"name": "bare allow entry does not match a path", "allow": ["ls"], "command": "/tmp/attacker/ls -la", "matches": false},
    {"name": "pinned path matches exact path", "allow": ["/usr/bin/ls"], "command": "/usr/bin/ls -la", "matches": true},
    {"name": "empty command", "allow": ["ls"], "command": "", "matches": false},
    {"name": "unbalanced quote", "allow": ["ls"], "command": "ls \"", "matches": false},
    {"name": "unlisted binary", "allow": ["ls"], "command": "cat /etc/passwd", "matches": false},
    {"name": "quoted binary name", "allow": ["my program"], "command": "\"my program\" arg1", "matches": true},
    {"name": "double quoted escaped quote", "allow": ["echo"], "command": "echo \"a\\\"b;c\"", "matches": true},
    {"name": "double quoted escaped backslash", "allow": ["echo"], "command": "echo \"a\\\\b\"", "matches": true},
    {"name": "double quoted backslash before ordinary char", "allow": ["echo"], "command": "echo \"a\\b\"", "matches": true},
    {"name": "double quoted escaped quote then unquoted operator", "allow": ["echo"], "command": "echo \"a\\\"\"; rm", "matches": false},
    {"name": "double quoted escaped backslash before closing quote then operator", "allow": ["echo"], "command": "echo \"a\\\\\"; rm", "matches": false}
  ]
}
